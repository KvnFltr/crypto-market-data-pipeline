{
  "uid": "marketpipe",
  "title": "marketpipe: market data pipeline",
  "tags": [
    "marketpipe"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Health",
      "id": 1,
      "collapsed": false,
